# ==============================================================================
# ElevateWeb Content Engine (Phase 1) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the server locally:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. Never commit .env or any file containing live secrets to version control.
# 2. Automated tests (npm test) run 100% offline with mocked OpenAI and Supabase
#    clients and DO NOT require .env or live API keys.
# ==============================================================================

# Server Port
# Port on which Fastify listens.
# Default: 3000
PORT=3000

# OpenAI API Key
# Required for live generation in development or production.
# Must have access to gpt-4o with structured output support.
# Format: sk-proj-...
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Project URL
# The HTTPS URL of your Supabase project instance.
# Format: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key
# Required for server-side persistence bypassing Row Level Security (RLS).
# CRITICAL: Keep strictly confidential. Never expose in client-side code.
# Format: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
